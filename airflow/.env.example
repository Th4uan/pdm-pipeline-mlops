# Gerado pelo startup-script.sh na VM a partir dos metadados da instancia.
# Nao edite na VM: rode de novo gcloud/10_airflow_vm.sh com REINICIAR=true.
AIRFLOW_UID=50000
AIRFLOW_IMAGE_BASE=apache/airflow:3.1.0-python3.12
AIRFLOW_IMAGE_NAME=airflow-mlops:local
GOOGLE_CLOUD_PROJECT=SEU_PROJECT_ID
AIRFLOW_VAR_PROJETO=SEU_PROJECT_ID
AIRFLOW_VAR_REGIAO=us-central1
AIRFLOW_VAR_BUCKET=SEU_PROJECT_ID-mlops-aula
AIRFLOW_VAR_GOLD_TABLE=SEU_PROJECT_ID.aula_pdm.imoveis_gold
AIRFLOW_CONN_GOOGLE_CLOUD_DEFAULT={"conn_type": "google_cloud_platform", "extra": {"project": "SEU_PROJECT_ID"}}
AIRFLOW__API_AUTH__JWT_SECRET=gerado-na-vm
